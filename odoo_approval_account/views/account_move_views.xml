<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form: approval state badge next to the status bar -->
    <record id="view_move_form_approval_state" model="ir.ui.view">
        <field name="name">account.move.form.approval.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="approval_engine_state" widget="badge"
                       decoration-warning="approval_engine_state == 'pending'"
                       decoration-success="approval_engine_state == 'approved'"
                       decoration-danger="approval_engine_state == 'rejected'"
                       decoration-muted="approval_engine_state == 'none'"
                       string="Approval"
                       invisible="approval_engine_state == 'none'"/>
            </xpath>
        </field>
    </record>

    <!-- Invoices list: approval column -->
    <record id="view_invoice_tree_approval_state" model="ir.ui.view">
        <field name="name">account.move.invoice.list.approval.state</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="approval_engine_state" widget="badge"
                       decoration-warning="approval_engine_state == 'pending'"
                       decoration-success="approval_engine_state == 'approved'"
                       decoration-danger="approval_engine_state == 'rejected'"
                       decoration-muted="approval_engine_state == 'none'"
                       string="Approval" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
