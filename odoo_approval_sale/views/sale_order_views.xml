<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the sale order form to show the approval state badge in the header -->
    <record id="view_order_form_approval_state" model="ir.ui.view">
        <field name="name">sale.order.form.approval.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert an approval_state badge widget just before the status bar -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field
                    name="approval_state"
                    widget="badge"
                    decoration-warning="approval_state == 'pending'"
                    decoration-success="approval_state == 'approved'"
                    decoration-danger="approval_state == 'rejected'"
                    decoration-muted="approval_state == 'none'"
                    string="Approval"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
