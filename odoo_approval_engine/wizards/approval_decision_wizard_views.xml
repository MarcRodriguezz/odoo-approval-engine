<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== approval.decision.wizard — Form View ===== -->
    <record id="approval_decision_wizard_form_view" model="ir.ui.view">
        <field name="name">approval.decision.wizard.form</field>
        <field name="model">approval.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Approval">
                <div class="alert alert-info" role="alert">
                    You are reviewing an approval request. Approve to pass it to
                    the next stage, or reject it (a reason is required).
                </div>
                <group>
                    <field name="document" readonly="1"/>
                    <field name="rule_id" readonly="1"/>
                    <field name="requested_by" readonly="1"/>
                </group>
                <separator string="Comment / Reason"/>
                <field name="comment"
                       placeholder="Add a comment (required when rejecting)…"/>
                <footer>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===== approval.decision.wizard — Dialog Action ===== -->
    <record id="action_approval_decision_wizard" model="ir.actions.act_window">
        <field name="name">Review Approval</field>
        <field name="res_model">approval.decision.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="approval_decision_wizard_form_view"/>
        <field name="target">new</field>
    </record>

</odoo>
