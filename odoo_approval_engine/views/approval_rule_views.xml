<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== approval.engine.rule — List View ===== -->
    <record id="approval_rule_list_view" model="ir.ui.view">
        <field name="name">approval.engine.rule.list</field>
        <field name="model">approval.engine.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="trigger_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ===== approval.engine.rule — Form View ===== -->
    <record id="approval_rule_form_view" model="ir.ui.view">
        <field name="name">approval.engine.rule.form</field>
        <field name="model">approval.engine.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. High-value sales orders"/>
                        </h1>
                    </div>
                    <group>
                        <group string="When does it apply?">
                            <field name="allowed_model_ids" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="trigger_event" invisible="1"/>
                            <field name="model_id" options="{'no_create': True}"
                                   domain="[('id', 'in', allowed_model_ids)]"
                                   placeholder="Choose a document type…"/>
                            <field name="trigger_id"
                                   required="1"
                                   readonly="not model_id"
                                   options="{'no_create': True}"
                                   domain="['|', ('model_id', '=', False), ('model_id', '=', model_id)]"
                                   placeholder="Which action requires approval?"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Who must approve" name="approvers">
                            <div class="text-muted mb-2">
                                Add one row per approval stage. Stages run top to
                                bottom: the request only moves on once each stage
                                has enough approvals.
                            </div>
                            <field name="level_ids">
                                <list editable="bottom" string="Approval stages">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Stage"
                                           placeholder="e.g. Manager"/>
                                    <field name="approver_type" string="Approved by"/>
                                    <field name="approver_group_id" string="Group"
                                           invisible="approver_type != 'group'"
                                           required="approver_type == 'group'"/>
                                    <field name="approver_expression" string="Expression"
                                           invisible="approver_type != 'expression'"
                                           required="approver_type == 'expression'"/>
                                    <field name="min_approvals"
                                           string="Required approvals"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conditions" name="conditions">
                            <group>
                                <field name="condition_domain" widget="domain"
                                       options="{'model': 'model_name'}"
                                       placeholder="Leave empty to match all records"/>
                            </group>
                            <group string="Python Condition (advanced)">
                                <field name="condition_python" widget="ace"
                                       options="{'mode': 'python'}"
                                       placeholder="# Return True/False&#10;# Context: record, user, datetime, relativedelta&#10;result = record.amount_total &gt; 10000"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== approval.engine.rule — Action ===== -->
    <record id="action_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">approval.engine.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first approval rule
            </p>
            <p>
                Pick a document type and the action that should require approval,
                then list who must approve it.
            </p>
        </field>
    </record>

</odoo>
