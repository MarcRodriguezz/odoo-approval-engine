<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Root Menu: Approval Engine =====
         Named distinctly to avoid clashing with Odoo's native "Approvals" app. -->
    <menuitem id="menu_approval_root"
              name="Approval Engine"
              web_icon="odoo_approval_engine,static/description/icon.png"
              sequence="50"
              groups="group_approval_user"/>

    <!-- ===== My Approvals (inbox) ===== -->
    <menuitem id="menu_approval_inbox"
              name="My Approvals"
              parent="menu_approval_root"
              action="action_approval_inbox"
              sequence="10"
              groups="group_approval_user"/>

    <!-- ===== All Requests ===== -->
    <menuitem id="menu_approval_requests"
              name="All Requests"
              parent="menu_approval_root"
              action="action_approval_request"
              sequence="20"
              groups="group_approval_user"/>

    <!-- ===== Configuration submenu ===== -->
    <menuitem id="menu_approval_configuration"
              name="Configuration"
              parent="menu_approval_root"
              sequence="90"
              groups="group_approval_manager"/>

    <!-- ===== Configuration > Rules ===== -->
    <menuitem id="menu_approval_rules"
              name="Rules"
              parent="menu_approval_configuration"
              action="action_approval_rule"
              sequence="10"
              groups="group_approval_manager"/>

</odoo>
